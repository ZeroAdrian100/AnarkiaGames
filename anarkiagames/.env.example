# Copia este archivo como .env (en esta misma carpeta) y completa los valores.
# .env está en .gitignore: nunca lo subas al repositorio.

# --- Base de datos (obligatorio) ---
URL_DATABASE=jdbc:sqlserver://localhost:1433;databaseName=anarkiagames;encrypt=false
USER_DATABASE=sa
PASSWORD_DATABASE=

# --- JWT (obligatorio) ---
# Clave en Base64 de al menos 32 bytes. Generar con: openssl rand -base64 32
JWT_SECRET=

# --- Administrador inicial (opcional) ---
# Se crea al arrancar si no existe ningún ADMIN. Mínimo 8 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Correo (opcional) ---
# Gmail con contraseña de aplicación. Sin estos valores, los correos se escriben en el log.
MAIL_USERNAME=
MAIL_PASSWORD=
# URL del frontend, para los enlaces de los correos.
# FRONTEND_URL=http://localhost:5173

# --- Pagos (opcional) ---
# mock (por defecto) o culqi
PAYMENT_GATEWAY=mock
CULQI_SECRET_KEY=

# --- Otros (opcional) ---
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# SPRING_PROFILES_ACTIVE=prod
